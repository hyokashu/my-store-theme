      </div>

      {%- comment -%} Tab 1 Panel {%- endcomment -%}
      <div class="cvh-featured__panel is-active" id="cvh-panel-{{ tab1_id }}" role="tabpanel">
        <div class="cvh-featured__scroll-wrap">
          <button class="cvh-scroll-arrow cvh-scroll-arrow--prev is-disabled" data-target="{{ tab1_id }}" aria-label="Scroll left" type="button"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
          <div class="cvh-featured__scroll" id="cvh-scroll-{{ tab1_id }}">
            {%- if tab1_col != blank -%}
              {%- for p in tab1_col.products limit: 15 -%}
                {%- assign pv = p.selected_or_first_available_variant -%}
                {%- assign p_sale = false -%}
                {%- if pv.compare_at_price > pv.price -%}{%- assign p_sale = true -%}{%- endif -%}
                {%- assign is_preorder = false -%}
                {%- assign is_new = false -%}
                {%- assign is_hot = false -%}
                {%- for tag in p.tags -%}
                  {%- assign lower_tag = tag | downcase -%}
                  {%- if lower_tag == 'pre-order' or lower_tag == 'preorder' -%}{%- assign is_preorder = true -%}
                  {%- elsif lower_tag == 'new' -%}{%- assign is_new = true -%}
                  {%- elsif lower_tag == 'hot' -%}{%- assign is_hot = true -%}
                  {%- endif -%}
                {%- endfor -%}

                <a href="{{ p.url }}" class="cvh-prod-card">
                  <div class="cvh-prod-card__img">
                    {%- if p.featured_image -%}
                      <img src="{{ p.featured_image | image_url: width: 280 }}" alt="{{ p.featured_image.alt | escape }}" width="280" height="280" loading="lazy">
                    {%- else -%}
                      <img src="https://placehold.co/280x280/eeecea/76798c?text={{ p.title | url_encode | truncate: 20, '' }}" alt="{{ p.title }}" width="280" height="280" loading="lazy">
                    {%- endif -%}
                    <div class="cvh-prod-card__badges">
                      {%- if is_preorder -%}<span class="cvh-prod-badge cvh-prod-badge--preorder">Pre-Order</span>{%- endif -%}
                      {%- if is_new -%}<span class="cvh-prod-badge cvh-prod-badge--new">New</span>{%- endif -%}
                      {%- if is_hot -%}<span class="cvh-prod-badge cvh-prod-badge--hot">🔥 Hot</span>{%- endif -%}
                      {%- if p_sale -%}<span class="cvh-prod-badge cvh-prod-badge--sale">Sale</span>{%- endif -%}
                    </div>
                    <button class="cvh-prod-card__quick-add"
                      data-variant-id="{{ pv.id }}"
                      data-has-variants="{% if p.variants.size > 1 %}true{% else %}false{% endif %}"
                      data-product-url="{{ p.url }}"
                      data-handle="{{ p.handle }}"
                      aria-label="Quick add {{ p.title }}"
                      type="button">+ Quick Add</button>
                  </div>
                  <div class="cvh-prod-card__info">
                    <span class="cvh-prod-card__type">{{ p.type }}</span>
                    <span class="cvh-prod-card__name">{{ p.title | remove: "One Piece Card Game: " | remove: "Pokemon TCG: " | strip }}</span>
                    <div class="cvh-prod-card__prices">
                      <span class="cvh-prod-card__price{% if p_sale %} cvh-prod-card__price--sale{% endif %}">{{ pv.price | money }}</span>
                      {%- if p_sale -%}<span class="cvh-prod-card__was">{{ pv.compare_at_price | money }}</span>{%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endfor -%}
            {%- elsif request.design_mode -%}
              <p style="color:var(--cv-muted-fg);padding:2rem 0;font-size:0.9rem;">Select a collection for <strong>{{ tab1_label }}</strong> in the theme editor sidebar.</p>
            {%- endif -%}
