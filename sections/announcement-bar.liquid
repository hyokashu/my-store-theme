{% comment %}
  Sprout — announcement-bar.liquid
  Dark announcement bar with rotating centred promo messages + right-aligned
  region/currency selector.  Messages are section blocks — editable via theme editor.
{% endcomment %}

{%- assign slot_s   = 5 -%}
{%- assign count    = section.blocks.size | at_least: 1 -%}
{%- assign total_s  = count | times: slot_s -%}
{%- assign slot_pct = 100 | divided_by: count -%}
{%- assign fade_pct = 2 -%}
{%- assign hold_pct = slot_pct | minus: fade_pct -%}

<style>
  @keyframes sd-announce-rotate {
    0%              { opacity: 0; transform: translateY(6px);  }
    {{ fade_pct }}% { opacity: 1; transform: translateY(0);    }
    {{ hold_pct }}% { opacity: 1; transform: translateY(0);    }
    {{ slot_pct }}% { opacity: 0; transform: translateY(-6px); }
    100%            { opacity: 0; transform: translateY(-6px); }
  }
</style>

<div
  class="sd-announce"
  id="sd-announce-bar"
  role="region"
  aria-label="Announcement"
  {% unless section.settings.show_bar %}style="display:none"{% endunless %}
>
  <div class="sd-announce__inner">

    {%- comment -%} ── Left spacer (mirrors selector width so text stays centred) ── {%- endcomment -%}
    <div class="sd-announce__left" aria-hidden="true"></div>

    {%- comment -%} ── Rotating promo messages ── {%- endcomment -%}
    <div class="sd-announce__text">
      {%- for block in section.blocks -%}
        {%- assign delay_s = forloop.index0 | times: slot_s -%}
        <span class="sd-announce__msg"
              style="animation-duration:{{ total_s }}s;animation-delay:{{ delay_s }}s"
              {{ block.shopify_attributes }}>
          {%- if block.settings.url != blank -%}
            <a href="{{ block.settings.url }}" class="sd-announce__link">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>

    {%- comment -%} ── Right: currency / region selector ── {%- endcomment -%}
    <div class="sd-announce__right">
      {%- if localization.available_currencies.size > 1 -%}
        {%- form 'localization', id: 'sd-currency-form', class: 'sd-currency-form' -%}
          <div class="sd-currency-wrap">
            <select
              name="currency_code"
              id="sd-currency-select"
              class="sd-currency-select"
              aria-label="Select currency"
              onchange="this.closest('form').submit()"
            >
              {%- for currency in localization.available_currencies -%}
                <option
                  value="{{ currency.iso_code }}"
                  {%- if currency.iso_code == localization.currency.iso_code %} selected{%- endif -%}
                >
                  {{ currency.iso_code }} {{ currency.symbol }}
                </option>
              {%- endfor -%}
            </select>
            <svg class="sd-currency-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        {%- endform -%}
      {%- else -%}
        {%- comment -%} Fallback: show current currency as static text {%- endcomment -%}
        <span class="sd-currency-static">
          {{ localization.currency.iso_code }} {{ localization.currency.symbol }}
        </span>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message text",
          "default": "Free shipping on orders over $150 AUD"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL (optional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on orders over $150 AUD" } },
        { "type": "message", "settings": { "text": "Cards you won't find in Australian stores — CN exclusives only" } },
        { "type": "message", "settings": { "text": "Sydney-based · Fast dispatch · Tracked shipping" } },
        { "type": "message", "settings": { "text": "Pokémon CN · One Piece CN · Riftbound — new drops weekly" } }
      ]
    }
  ]
}
{% endschema %}
